# Скопируйте в .env и при необходимости измените
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms
# Секрет подписи JWT — обязательно смените для любого не-демо запуска
JWT_SECRET=change-me-please-very-long-random-string
JWT_TTL_DAYS=7
# Хост, который печатается в QR-коде сертификата (https://<PUBLIC_HOST>/verify/<code>)
PUBLIC_HOST=localhost
# 1 = заполнить БД демо-данными при первом старте
SEED_DEMO=1
