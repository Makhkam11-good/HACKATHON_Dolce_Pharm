# Скопируйте в .env и при необходимости измените
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms
# Секрет подписи JWT — обязательно смените для любого не-демо запуска
JWT_SECRET=change-me-please-very-long-random-string
JWT_TTL_DAYS=7
# Внешний адрес для абсолютных ссылок (QR проверки сертификата): например https://lms.example.kz
# Пусто — адрес берётся из запроса (X-Forwarded-Host/Proto), это нужно для Cloudflare Tunnel,
# где адрес *.trycloudflare.com меняется при каждом перезапуске.
PUBLIC_BASE_URL=
# Запасной хост, если адрес не удалось определить ни из PUBLIC_BASE_URL, ни из запроса
PUBLIC_HOST=localhost
# 1 = заполнить БД демо-данными при первом старте
SEED_DEMO=1
